# SEALP Workspace Layout v1.0
# tower_optimal_initial

format_version: '1.0'
name: tower_optimal_initial
robot_base:
  pos:
  - !!float '0'
  - !!float '0'
  - !!float '0'
  rotmat:
  - - !!float '1'
    - !!float '0'
    - !!float '0'
  - - !!float '0'
    - !!float '1'
    - !!float '0'
  - - !!float '0'
    - !!float '0'
    - !!float '1'
assembly_station:
  pos:
  - 0.345
  - -0.35
  - !!float '0'
  rotmat:
  - - !!float '1'
    - !!float '0'
    - !!float '0'
  - - !!float '0'
    - !!float '1'
    - !!float '0'
  - - !!float '0'
    - !!float '0'
    - !!float '1'
staging:
  base_plate:
    pos:
    - 0.345
    - -0.35
    - !!float '0'
    rotmat:
    - - !!float '1'
      - !!float '0'
      - !!float '0'
    - - !!float '0'
      - !!float '1'
      - !!float '0'
    - - !!float '0'
      - !!float '0'
      - !!float '1'
  post_br:
    pos:
    - 0.634109
    - -0.109862
    - 0.003
    rotmat:
    - - !!float '1'
      - !!float '0'
      - !!float '0'
    - - !!float '0'
      - !!float '1'
      - !!float '0'
    - - !!float '0'
      - !!float '0'
      - !!float '1'
  post_fr:
    pos:
    - 0.510971
    - -0.612339
    - 0.003
    rotmat:
    - - !!float '1'
      - !!float '0'
      - !!float '0'
    - - !!float '0'
      - !!float '1'
      - !!float '0'
    - - !!float '0'
      - !!float '0'
      - !!float '1'
  post_bl:
    pos:
    - 0.62025
    - 0.155245
    - 0.003
    rotmat:
    - - !!float '1'
      - !!float '0'
      - !!float '0'
    - - !!float '0'
      - !!float '1'
      - !!float '0'
    - - !!float '0'
      - !!float '0'
      - !!float '1'
  post_fl:
    pos:
    - 0.032483
    - -0.421178
    - 0.003
    rotmat:
    - - !!float '1'
      - !!float '0'
      - !!float '0'
    - - !!float '0'
      - !!float '1'
      - !!float '0'
    - - !!float '0'
      - !!float '0'
      - !!float '1'
  middle_plate:
    pos:
    - 0.400839
    - 0.0344391
    - 0.093
    rotmat:
    - - 0.707107
      - !!float '0'
      - 0.707107
    - - 0.707107
      - !!float '0'
      - -0.707107
    - - !!float '0'
      - !!float '1'
      - !!float '0'
  top_cross:
    pos:
    - 0.414574
    - 0.171337
    - 0.003
    rotmat:
    - - !!float '1'
      - !!float '0'
      - !!float '0'
    - - !!float '0'
      - !!float '1'
      - !!float '0'
    - - !!float '0'
      - !!float '0'
      - !!float '1'
metadata:
  search_method: weighted_random_on_work_table
  l3_pass: false
  l3_fail_reason: ''
  score: 0.641341
  score_components:
    grasp: 0.865156
    manip: 0.149565
    dist: 0.560314
    rot: 0.720943
    spatial_y_distribution: 0.825
  spatial_constraints:
    min_staging_mesh_clearance: 0.01
    enforce_order_x_constraint: false
    order_x_tolerance: 0.03
    enable_y_side_distribution_score: true
    force_upright_when_topdown_low: true
    topdown_min_count: 10
    upright_rule: if identity topdown(-Z) count < threshold, non-upright initial poses
      are forbidden
    topdown_align_cos: 0.82
    check_l2_pick_quick_motion: false
    l2_pick_check_parts:
    - middle_plate
    l2_pick_check_lift_dist: 0.06
    l2_pick_check_directions:
    - z
    - x_plus
    - x_minus
    - y_plus
    - y_minus
    l2_pick_check_tilt: 0.35
    goal_y_side_biased_sampling: true
    goal_y_side_bias_ratio: 0.75
    goal_y_side_eps: 0.005
    goal_y_side_rule: if goal y is larger than other parts, prefer left half table;
      if smaller, prefer right half table; fallback to full table
    robot_home_clearance: 0.03
  weights:
    grasp: 0.4
    manip: 0.15
    dist: 0.25
    rot: 0.2
  part_order:
  - base_plate
  - post_br
  - post_fr
  - post_bl
  - post_fl
  - middle_plate
  - top_cross
  assembly_region_id: r1_c1
  assembly_region_rc:
  - 1
  - 1
  assembly_station_pos:
  - 0.345
  - -0.35
  - !!float '0'
  preassemble_first_part: true
  filter_assembly_near_arms: false
  assembly_region_rule: 3x3 centers are all tried; only preassembled first part collision
    with arm boxes can reject an assembly center
  assembly_arm_x_clearance: 0.22
  assembly_arm_y_clearance: 0.22
  filter_staging_near_arms: true
  staging_arm_x_clearance: 0.12
  staging_arm_y_clearance: 0.12
  arm_base_xy_map:
    lft_arm_base:
    - !!float '0'
    - !!float '0'
    rgt_arm_base:
    - !!float '0'
    - -0.62
  grasp_counts:
    base_plate: 20
    post_br: 42
    post_fr: 51
    post_bl: 39
    post_fl: 115
    middle_plate: 73
    top_cross: 26
  topdown_counts_identity:
    post_br: 676
    post_fr: 676
    post_bl: 676
    post_fl: 676
    middle_plate: 0
    top_cross: 398
  arm_choice:
    base_plate: preassembled
    post_br: lft
    post_fr: rgt
    post_bl: lft
    post_fl: rgt
    middle_plate: lft
    top_cross: lft
  pose_tag:
    base_plate: preassembled_at_assembly_region
    post_br: identity
    post_fr: identity
    post_bl: identity
    post_fl: identity
    middle_plate: fs_upright_lifted
    top_cross: identity
  rot_name:
    base_plate: goal_pose
    post_br: identity
    post_fr: identity
    post_bl: identity
    post_fl: identity
    middle_plate: fs_02
    top_cross: identity
  z_offsets:
    base_plate: !!float '0'
    post_br: 0.003
    post_fr: 0.003
    post_bl: 0.003
    post_fl: 0.003
    middle_plate: 0.093
    top_cross: 0.003
  per_part_dist:
    base_plate: !!float '0'
    post_br: 0.256049
    post_fr: 0.202441
    post_bl: 0.569656
    post_fl: 0.217434
    middle_plate: 0.408932
    top_cross: 0.575633
  per_part_manip:
    base_plate: !!float '0'
    post_br: !!float '0'
    post_fr: 0.00430677
    post_bl: !!float '0'
    post_fl: 0.0040619
    middle_plate: 0.0123802
    top_cross: 0.0132726
  per_part_rot_angle:
    base_plate: !!float '0'
    post_br: !!float '0'
    post_fr: !!float '0'
    post_bl: !!float '0'
    post_fl: !!float '0'
    middle_plate: 1.71777
    top_cross: !!float '0'
  table_top_z: !!float '0'
  table_x_range:
  - 0.005
  - 0.685
  table_y_range:
  - -0.89
  - 0.19
  rotation_lift_rule: z_offset = table_top_z + clearance - rotated_z_min
  check_robot_home_collision: true
  strict_initial_robot_collision: true
  robot_home_collision_rule: all initial objects including preassembled first part
    must not collide with lft/rgt arm collision boxes at HOME_JV
  robot_home_clearance_rule: all staging models should keep at least 0.030m AABB clearance
    from robot home links when link AABBs are available
  l2_pick_quick_motion_rule: for selected parts, common grasp ids must survive pre-pick
    / pick / post-pick quick check against dynamic obstacles
